PORT=3000
DATA_FILE=./data/fcc-v2.json
AI_PROVIDER=local
AWS_REGION=ap-northeast-2
# Bedrock 사용 시 AI_PROVIDER=bedrock 및 접근 가능한 모델 ID 설정
BEDROCK_MODEL_ID=
# fcc-ai(GPU STT, feature/stt-service)를 로컬에서 uvicorn으로 띄운 주소. 비워두면 음성 질문 API는 503을 반환합니다.
STT_SERVICE_URL=http://127.0.0.1:8000
STT_TIMEOUT_MS=15000
# base64 인코딩된 오디오 요청 본문의 최대 바이트 수(기본 4MB)
AUDIO_MAX_BYTES=4194304
# Lambda 환경은 SAM 템플릿에서 자동 주입
DYNAMODB_TABLE=
COGNITO_CLIENT_ID=
